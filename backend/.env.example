# SMTP server details (for Gmail, use smtp.gmail.com and a Google app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password

# Use the mailbox address as the sender unless your provider specifies otherwise
SMTP_FROM=your-email@example.com

# Destination for contact form messages
CONTACT_TO=info@lioraluxeewellness.com

# Optional server settings (defaults: PORT=3001, HOST=127.0.0.1)
# PORT=3001
# HOST=127.0.0.1

# Set true only when the backend is reachable exclusively through a trusted proxy
# TRUST_PROXY=false
